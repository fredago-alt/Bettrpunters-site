# Solana meme-coin PAPER TRADING simulator - configuration
# PAPER TRADING ONLY. There is no wallet, key, signing or live-trading setting,
# and the app refuses to start if PRIVATE_KEY / SEED_PHRASE / MNEMONIC /
# LIVE_TRADING (and similar) are set in the environment.
#
# Copy to .env and edit. Every value below is the default. All strategy numbers
# are hypotheses to test, not proven-profitable settings.

# --- storage ---------------------------------------------------------------
PAPERBOT_DB_PATH=data/paperbot.sqlite3

# --- virtual account (AUD) -------------------------------------------------
PAPERBOT_STARTING_CASH_AUD=50
PAPERBOT_MAX_OPEN_POSITIONS=1
PAPERBOT_POSITION_PCT_OF_CASH=0.10
PAPERBOT_MAX_POSITION_AUD=5
PAPERBOT_MIN_POSITION_AUD=0.50

# --- entry filters (hypotheses) ---------------------------------------------
PAPERBOT_MIN_LIQUIDITY_USD=25000
PAPERBOT_MIN_PAIR_AGE_MINUTES=1
PAPERBOT_MAX_PAIR_AGE_MINUTES=30
PAPERBOT_MIN_TXNS_M5=10
PAPERBOT_MIN_BUY_SELL_RATIO=1.2
PAPERBOT_MAX_PRICE_CHANGE_M5_PCT=300
PAPERBOT_ALLOWED_QUOTE_SYMBOLS=SOL,USDC
# Reject pairs with zero observed sells in 5 min (sellability unverified).
PAPERBOT_REJECT_ZERO_SELLS=true

# --- exits (hypotheses; evaluated on executable net value after costs) -----
PAPERBOT_TAKE_PROFIT_PCT=15
PAPERBOT_STOP_LOSS_PCT=-10
PAPERBOT_MAX_HOLD_MINUTES=15
# ASSUMPTION: a position with no price data this long is written off...
PAPERBOT_STALE_WRITEOFF_MINUTES=60
# ...recovering this % of its cost (0 = assume unsellable).
PAPERBOT_STALE_RECOVERY_PCT=0

# --- execution cost model (PLACEHOLDER ASSUMPTIONS, not measurements) -------
PAPERBOT_FEE_PCT_PER_SIDE=1.0
PAPERBOT_SLIPPAGE_PCT_PER_SIDE=1.5
# Extra slippage = factor * order_usd / liquidity_usd (0 disables).
PAPERBOT_SLIPPAGE_IMPACT_FACTOR=0
PAPERBOT_LATENCY_SECONDS=3
PAPERBOT_ENTRY_FILL_FAILURE_PROB=0.05
PAPERBOT_EXIT_FILL_FAILURE_PROB=0.05
PAPERBOT_MAX_ENTRY_DRIFT_PCT=10
PAPERBOT_FILL_TIMEOUT_SECONDS=90
PAPERBOT_RANDOM_SEED=42

# --- FX (token prices are USD; account is AUD) ----------------------------
# live = ECB daily reference rate via api.frankfurter.dev (cached), falling
# back to the static rate below; static = always use the static rate.
PAPERBOT_FX_MODE=live
PAPERBOT_FX_STATIC_AUD_PER_USD=1.42
PAPERBOT_FX_CACHE_SECONDS=3600

# --- scanner / DEX Screener API --------------------------------------------
# TOKEN-PROFILES (default) and/or TOKEN-BOOSTS
PAPERBOT_DISCOVERY_FEEDS=TOKEN-PROFILES
PAPERBOT_POLL_INTERVAL_SECONDS=15
# Re-observe tracked tokens every 30 s while their pair could still pass the
# age filter, then every 10 min (to record disappearance) until the window ends.
PAPERBOT_TRACK_POLL_INTERVAL_SECONDS=30
PAPERBOT_SLOW_TRACK_POLL_INTERVAL_SECONDS=600
PAPERBOT_TRACK_WINDOW_MINUTES=120
PAPERBOT_STORE_RAW_JSON=false
PAPERBOT_DEXSCREENER_BASE_URL=https://api.dexscreener.com
PAPERBOT_HTTP_TIMEOUT_SECONDS=10
PAPERBOT_HTTP_MAX_RETRIES=4
# Documented limits: 60/min (profiles/boosts), 300/min (pairs). Keep below.
PAPERBOT_PROFILES_RATE_PER_MIN=50
PAPERBOT_PAIRS_RATE_PER_MIN=250

PAPERBOT_LOG_LEVEL=INFO
